# Copy this file to .env and fill in only the keys you need.
# .env is gitignored — never commit real keys.
# Every key is optional: the CLI backtest runs on free yfinance data with none set.

# Alpaca PAPER trading keys (https://app.alpaca.markets → Paper account → API Keys).
# Unlocks the paper-trading broker, My Trades, News Radar (Alpaca news) and the daily job.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# TypeSafe AI key — unlocks the Jev signal backend (Phase H).
# TYPESAFE_API_KEY=

# Anthropic API key — optional; lets News Radar and the daily job score headlines with Claude
# (otherwise a simple word list is used). https://console.anthropic.com → API Keys.
# ANTHROPIC_API_KEY=

# Password for visitors who reach the app through the Cloudflare tunnel (scripts/go_live.sh).
# Required for going live; the app refuses to serve internet visitors without it.
# APP_PASSWORD=

# Safety switch for the bot/broker. true = orders are logged, never sent. Default off.
# DRY_RUN=true
